# Item photo uploads (Cloudflare R2). All optional: leave them unset and the
# app runs as normal, "Add photo" just says uploads aren't set up yet.
#
# R2_ACCOUNT_ID       Cloudflare dashboard > R2 > Overview, "Account ID"
# R2_ACCESS_KEY_ID    from an R2 API token (R2 > Manage API tokens)
# R2_SECRET_ACCESS_KEY  shown once, when that token is created
# R2_BUCKET           the bucket's name
# R2_PUBLIC_URL       the bucket's public address, no trailing slash:
#                     its r2.dev URL or your custom domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=item-photos
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
