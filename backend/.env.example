# Copy to .env for local dev, or set these directly in your host's
# environment-variable settings for a real deployment. See env.ts for the
# validation each of these goes through -- if one's missing or malformed,
# the server refuses to start and tells you exactly which.

# dev | test | production -- gates cookie secure/sameSite, which pooled
# Postgres connection is used, and console logging in env.ts.
APP_STAGE=dev

# Standard Node env; mostly deferred to by other libraries.
NODE_ENV=development

# Whatever your host assigns -- Render/Railway/Fly inject this themselves,
# so this default only matters for local dev.
PORT=3000

# Postgres connection strings (Neon or otherwise). DATABASE_URL_DIRECT is
# optional -- only needed if something (e.g. drizzle-kit migrate) requires
# an unpooled connection.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_DIRECT=

# Resend (invite emails). Get a key at resend.com; RESEND_FROM_EMAIL must be
# on a domain you've verified there.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=invites@yourdomain.com

# The frontend's real URL -- used to build the link inside invite emails.
FRONTEND_URL=http://localhost:5173

# Long random string, used to sign access/refresh tokens. Generate one with
# `openssl rand -hex 32` -- never reuse the value committed to this repo's
# git history for a real deployment, since anyone who's seen it can forge
# tokens.
JWT_SECRET=

REFRESH_TOKEN_EXPIRES_DAYS=2
INVITE_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Comma-separated origins allowed to call the API with credentials. Must
# include your real hosted frontend URL once this is deployed, or every
# request from it gets blocked by CORS before it reaches your routes.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
