# Baked into the bundle by `vite build` (mode=production) automatically.
#
# This is the single most-forgotten step when deploying: build without it and
# the app falls back to a relative "/api/v1", which resolves against the
# static host (DomainKing) instead of Render -- login then fails with a 404
# or a CORS error that looks like a backend problem. Committing it here means
# a plain `npm run build` is always correct, for every deployment target.
#
# It is not a secret: everything in a Vite build is public, and the API URL is
# the same one the browser calls anyway.
VITE_API_URL=https://inventory-wbsite.onrender.com/api/v1
